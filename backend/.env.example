# Copy this file to .env and fill it in. NEVER commit .env.

# --- Sender identity (used in the email footer) ---
SENDER_NAME=Ali Nasrullah
COMPANY_NAME=Zarin Tech AB
# Required before real emails can be sent (shown in the footer of every email)
COMPANY_ORG_NUMBER=
SENDER_PHONE=

# --- SMTP: your mailbox on the company domain ---
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none
SMTP_SECURITY=starttls
SMTP_USER=ali.nasrullah@zarintech.se
SMTP_PASSWORD=
SMTP_FROM=ali.nasrullah@zarintech.se

# --- Throttling ---
# Seconds to wait between emails (random value in this range) and max real emails per day (UTC)
SEND_DELAY_MIN=30
SEND_DELAY_MAX=60
DAILY_CAP=30

# --- Bolagsverket "Värdefulla datamängder" (free; register for OAuth2 client credentials) ---
BOLAGSVERKET_CLIENT_ID=
BOLAGSVERKET_CLIENT_SECRET=
# Defaults below; only change if Bolagsverket tells you to
# BOLAGSVERKET_TOKEN_URL=https://gw.api.bolagsverket.se/oauth2/token
# BOLAGSVERKET_BASE_URL=https://gw.api.bolagsverket.se/vardefulla-datamangder/v1
# BOLAGSVERKET_SCOPE=vardefulla-datamangder:read

# --- Misc ---
# Identifies this tool to the websites and map servers it contacts
USER_AGENT=LeadFinderBot/0.1 (+mailto:ali.nasrullah@zarintech.se)
# DATABASE_URL=sqlite:///./data/leadfinder.db
# CORS_ORIGINS=http://localhost:5173
